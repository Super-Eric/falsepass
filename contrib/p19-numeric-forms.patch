     ]
 
 
+# --- P19: the same number written differently ------------------------------------------
+
+
+NUMERIC = re.compile(r"[+-]?\d+(?:\.\d+)?")
+
+
+def numeric_forms(answer: str) -> dict[str, str]:
+    """Value-identical ways to write the reference when it is a plain number.
+
+    Only surface changes: no unit, no rounding and no re-grouping that changes the value.
+    A grader that rejects these reads the string instead of the number (a false fail);
+    a prompt that demands exactly one spelling may reject them on purpose, so this row
+    is a lead like P2, not an exploit.
+    """
+    from decimal import Decimal
+
+    text = answer.strip()
+    if not NUMERIC.fullmatch(text):
+        return {}
+    value = Decimal(text)
+    digits = text.lstrip("+-")
+    forms: dict[str, str] = {}
+    if value == value.to_integral_value() and "." not in digits:
+        forms["trailing_zero"] = text + ".0"
+    elif "." in digits:
+        forms["one_more_decimal"] = text + "0"
+    if value == value.to_integral_value() and len(digits.split(".")[0]) >= 4:
+        forms["thousands_separator"] = f"{int(value):,}"
+    if not text.startswith("-"):
+        forms["plus_sign"] = "+" + text
+    else:
+        forms["unicode_minus"] = "\u2212" + text[1:]
+    return {name: form for name, form in forms.items() if form != text}
+
+
+async def p19_numeric_forms(adapter: Adapter, scorer: Scorer, ex: Example) -> list[ProbeResult]:
+    """The same number, written another way, must keep full reward."""
+    return [
+        await check("P19", "numeric_forms", variant, Expect.FULL, adapter.render(done, ex), adapter, scorer, ex)
+        for variant, done in numeric_forms(ex.answer).items()
+    ]
+
+
 # --- T7: a tool call before the answer --------------------------------------------------
