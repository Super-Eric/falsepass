@@ -55 +55,12 @@ def test_strict_verifier_only_fails_on_brittleness(probe):
-    assert {r.probe for r in failed} <= {"P2"}  # strict graders are brittle, never exploitable
+    assert {r.probe for r in failed} <= {"P2", "P19"}  # strict graders are brittle, never exploitable
+
+
+def numeric_tolerant(text, answer):  # reads the last number and compares values
+    nums = re.findall(r"[-+]?\d+(?:\.\d+)?", text.replace(",", ""))
+    return float(bool(nums) and abs(float(nums[-1]) - float(answer)) < 1e-9)
+
+
+def test_p19_flags_a_string_matching_grader_and_clears_a_numeric_one():
+    flagged = [r for r in run(probes.p19_numeric_forms, strict) if not r.passed]
+    assert flagged and {r.variant for r in flagged} >= {"trailing_zero", "plus_sign"}
+    assert all(r.passed for r in run(probes.p19_numeric_forms, numeric_tolerant))
